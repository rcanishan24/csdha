import "./bootstrap";
import QrScanner from "qr-scanner";

import.meta.glob([
    "../images/**",
    "../fonts/**",
]);

/**
 * =========================
 * GLOBAL STATE
 * =========================
 */
let CURRENT_REQUEST = null;
let BLOB_URLS = [];
let QR_SCANNER = null;

/**
 * =========================
 * INIT BOOT SEQUENCE
 * =========================
 */
initApp();

function initApp() {
    hideNoscript();
    setTimezone();
    activateAttendanceRecorder();
    showAttachmentPreview();
    initUIEnhancers();
}

/**
 * =========================
 * UI CORE HELPERS (MODERN FEEL)
 * =========================
 */
function initUIEnhancers() {
    document.body.classList.add("ui-ready");
}

function hideNoscript() {
    document.querySelector("#noscript")?.remove();
}

/**
 * =========================
 * COOKIE + TIMEZONE (CLEANED)
 * =========================
 */
function setTimezone() {
    const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    setCookie("timezone", timezone);
}

function setCookie(name, value) {
    const date = new Date();
    date.setFullYear(date.getFullYear() + 1);

    document.cookie = `${name}=${value}; expires=${date.toUTCString()}; path=/; SameSite=Lax`;
}

/**
 * =========================
 * ATTENDANCE API (UNIFIED)
 * =========================
 */
async function storeAttendance(token) {
    if (CURRENT_REQUEST) {
        const res = await CURRENT_REQUEST;
        return res.status;
    }

    const eventField = document.querySelector("#event");
    if (!eventField?.value) return 400;

    const timezone = getCookie("timezone") || "UTC";

    try {
        CURRENT_REQUEST = axios.post(`/api/attendance/${eventField.value}`, {
            token,
            timezone
        });

        const res = await CURRENT_REQUEST;
        return res.status;

    } catch (err) {
        console.error("Attendance error:", err);
        return 500;

    } finally {
        CURRENT_REQUEST = null;
    }
}

function getCookie(name) {
    return document.cookie
        .split("; ")
        .find(row => row.startsWith(name + "="))
        ?.split("=")[1];
}

/**
 * =========================
 * ATTACHMENT PREVIEW (MODERN UX FIXED)
 * =========================
 */
function showAttachmentPreview() {
    const page = document.querySelector(
        ".main-content.events.attachments.form.create"
    );
    if (!page) return;

    const input = page.querySelector("#images-input");
    if (!input) return;

    createAttachmentPreview(input);

    input.addEventListener("change", () => {
        createAttachmentPreview(input);
    });
}

function createAttachmentPreview(input) {
    const files = input.files;
    if (!files?.length) return;

    const page = document.querySelector(
        ".main-content.events.attachments.form.create"
    );

    const links = page.querySelector("#attachment-view-links");
    const views = page.querySelector("#attachment-views");

    const linkTpl = page.querySelector("#attachment-view-link-temp")?.content;
    const viewTpl = page.querySelector("#attachment-view-temp")?.content;

    if (!links || !views || !linkTpl || !viewTpl) return;

    // cleanup old blobs
    BLOB_URLS.forEach(URL.revokeObjectURL);
    BLOB_URLS = [];

    links.replaceChildren();
    views.replaceChildren();

    [...files].forEach((file, i) => {
        const url = URL.createObjectURL(file);
        BLOB_URLS.push(url);

        const link = linkTpl.cloneNode(true).firstElementChild;
        const view = viewTpl.cloneNode(true).firstElementChild;

        const imgThumb = link.querySelector("img");
        const imgFull = view.querySelector("img");
        const removeBtn = view.querySelector("[data-remove]");

        if (imgThumb) imgThumb.src = url;
        if (imgFull) imgFull.src = url;

        link.href = `#attachment-${i}`;
        view.id = `attachment-${i}`;

        removeBtn?.addEventListener("click", () => {
            link.remove();
            view.remove();
            removeFileFromInput(file, input);
        });

        links.appendChild(link);
        views.appendChild(view);
    });
}

function removeFileFromInput(fileToRemove, input) {
    const dt = new DataTransfer();

    [...input.files].forEach(file => {
        if (file !== fileToRemove) dt.items.add(file);
    });

    input.files = dt.files;
}

/**
 * =========================
 * QR SCANNER (MODERN FLOW)
 * =========================
 */
function showQrScannerStatus(type) {
    const scanner = document.getElementById("id-scanner");
    if (!scanner) return;

    const indicator = scanner.querySelector(".indicator");
    const data = JSON.parse(scanner.querySelector(".status-values")?.textContent || "{}");

    const timeout = indicator?.querySelector(".timeout");
    const text = indicator?.querySelector(".status .text");

    if (!indicator || !data[type]) return;

    void indicator.offsetWidth;

    indicator.className = `indicator ${data[type].class}`;
    if (text) text.textContent = data[type].text;

    if (["success", "failure"].includes(type)) {
        timeout?.addEventListener("animationend", function reset() {
            indicator.className = `indicator ${data.idle.class}`;
            if (text) text.textContent = data.idle.text;
            timeout.removeEventListener("animationend", reset);
        });
    }
}

function startQrScanner() {
    showQrScannerStatus("idle");

    const video = document.querySelector("#id-scanner .video");
    const container = document.getElementById("id-scanner");

    if (!video || !container) return;

    container.hidden = false;

    if (!QR_SCANNER) {
        QR_SCANNER = new QrScanner(video, async (result) => {
            showQrScannerStatus("processing");

            const status = await storeAttendance(result.data);

            if (status === 200) showQrScannerStatus("success");
            else showQrScannerStatus("failure");

        }, { returnDetailedScanResult: true });
    }

    QR_SCANNER.start();
}

function stopQrScanner() {
    document.getElementById("id-scanner")?.setAttribute("hidden", true);
    QR_SCANNER?.stop();
}

/**
 * =========================
 * ATTENDANCE FEATURE INIT
 * =========================
 */
function activateAttendanceRecorder() {
    const page = document.querySelector(".main-content.attendance .article");
    if (!page) return;

    if (!navigator.mediaDevices?.getUserMedia) {
        page.insertAdjacentHTML(
            "beforeend",
            `<p class="alert alert-warning">
                Camera not supported in this browser.
            </p>`
        );
        return;
    }

    const template = document.querySelector(".attendance #scanner-feature");
    if (!template) return;

    const clone = template.content.cloneNode(true);
    template.before(clone);

    const select = page.querySelector("select#event");

    if (select) {
        select.addEventListener("change", e => {
            e.target.value ? startQrScanner() : stopQrScanner();
        });
        return;
    }

    startQrScanner();
}
